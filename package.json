{
  "name": "soundboard",
  "version": "0.1.0",
  "private": false,
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tunajs": "^1.1.3"
  },
  "scripts": {
    "analyze": "vite build --sourcemap && source-map-explorer \"build/assets/*.js\"",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate": "node ./tools/json-generator.ts",
    "prepare": "husky",
    "lint": "prettier --check . && oxlint && tsc",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{ts,tsx}": "oxlint"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "node-id3": "^0.2.9",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "source-map-explorer": "^2.5.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
